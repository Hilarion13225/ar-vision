# Clé gratuite à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèle multimodal de l'offre gratuite. Flash-Lite : ~1,3 s par analyse, quotas larges.
# Alternative plus précise mais plus lente : gemini-flash-latest
GEMINI_MODEL=gemini-flash-lite-latest

# Modèle utilisé si le principal est saturé (503), à court de quota (429) ou trop lent.
# Laisser vide pour désactiver le repli.
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Délai (secondes, 10 minimum) accordé au modèle principal avant de basculer sur le repli
GEMINI_TIMEOUT_S=10

# 1 = réponses simulées, aucun appel à Gemini (développement sans quota)
# ratelimit = simule un quota épuisé (test du message d’erreur)
GEMINI_MOCK=0

PORT=5000
